  {"id":"order-in","type":"http in","z":"tab1","name":"POST order","url":"/api/orders","method":"post","upload":false,"swaggerDoc":"","x":120,"y":220,"wires":[["validate"]]},
  {"id":"validate","type":"function","z":"tab1","name":"校验并保存消息","func":"const p=msg.payload||{};const keys=Object.keys(p);if(keys.some(k=>!['request_id','sku','quantity'].includes(k))||!Number.isInteger(p.quantity)||p.quantity<=0||!/^[A-Za-z0-9-]{6,40}$/.test(String(p.request_id||''))||!/^[A-Za-z0-9_-]{2,24}$/.test(String(p.sku||''))){msg.statusCode=400;msg.payload={error:'invalid_order'};return [null,msg];}msg.order={request_id:p.request_id,sku:String(p.sku).toUpperCase(),quantity:p.quantity};msg.payload=msg.order;msg.method='POST';msg.url='http://127.0.0.1:8001/reserve';msg.headers={'content-type':'application/json'};return [msg,null];","outputs":2,"x":340,"y":220,"wires":[["reserve-http"],["order-out"]]},
  {"id":"reserve-http","type":"http request","z":"tab1","name":"调用库存服务","method":"use","ret":"obj","paytoqs":"ignore","url":"","persist":false,"authType":"","senderr":true,"headers":[],"x":560,"y":200,"wires":[["classify"]]},
  {"id":"classify","type":"function","z":"tab1","name":"分类业务和依赖结果","func":"if(!msg.statusCode){msg.statusCode=502;msg.payload={error:'inventory_unavailable'};}else if(msg.statusCode>=500){msg.statusCode=502;msg.payload={error:'inventory_dependency_error'};}return msg;","outputs":1,"x":790,"y":200,"wires":[["order-out"]]},
  {"id":"order-out","type":"http response","z":"tab1","name":"订单响应","statusCode":"","headers":{},"x":1010,"y":220,"wires":[]},
  {"id":"catch","type":"catch","z":"tab1","name":"捕获调用异常","scope":["reserve-http"],"uncaught":false,"x":570,"y":270,"wires":[["catch-fn"]]},
  {"id":"catch-fn","type":"function","z":"tab1","name":"依赖异常脱敏","func":"msg.statusCode=502;msg.payload={error:'inventory_unavailable',request_id:msg.order&&msg.order.request_id};return msg;","outputs":1,"x":790,"y":270,"wires":[["order-out"]]},

